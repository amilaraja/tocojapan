        "description": "Cost, insurance and freight to a destination port, on your own price for the vehicle. Estimate only: inspection fees and import duties are not included.",
        "security": [
          {
            "bearer": []
          },
          {
            "oauth": [
              "cif:read"
            ]
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "stock_no",
                  "port_id"
                ],
                "additionalProperties": false,
                "properties": {
                  "stock_no": {
                    "type": "string",
                    "examples": [
                      "E02060"
                    ]
                  },
                  "port_id": {
                    "type": "integer",
                    "description": "id from GET /catalog/ports."
                  }
