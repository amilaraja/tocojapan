{
  "openapi": "3.1.0",
  "info": {
    "title": "Toco Partner Stock API",
    "version": "1.0.0-draft",
    "summary": "Show Toco International's live vehicle stock on your own website.",
    "description": "Server-to-server API for approved Toco partners. Read the partner guide first: it explains authentication, syncing, photos and errors. Browser calls are not supported.",
    "contact": {
      "name": "Toco International",
      "url": "https://tocojapan.com/contact"
    }
  },
  "servers": [
    {
      "url": "https://api.tocojapan.com/partner/v1",
      "description": "Production (once the API host is live)"
    },
    {
      "url": "https://tocojapan.com/partner/v1",
      "description": "Production (current host)"
    }
  ],
  "security": [
    {
      "bearer": []
    }
  ],
  "tags": [
    {
      "name": "Authentication",
      "description": "Exchange your client credentials for a 15-minute access token."
    },
    {
      "name": "Stock",
      "description": "Toco vehicles in your contracted scope, with full and change-only sync."
    },
    {
      "name": "Catalogue",
      "description": "Reference lists for filters and CIF estimates."
    },
    {
      "name": "CIF",
      "description": "Shipping cost estimates on your own prices."
    }
  ],
  "paths": {
    "/oauth/token": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "operationId": "createToken",
        "summary": "Get an access token",
        "description": "OAuth 2.0 client-credentials grant (RFC 6749 section 4.4). Send your client_id and client_secret as HTTP Basic authentication (preferred) or as form fields. Tokens last 15 minutes; request a new one when it expires. Failed attempts are limited per IP address.",
        "security": [
          {},
          {
            "clientBasic": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "$ref": "#/components/schemas/TokenRequest"
              }
            },
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TokenRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Token issued.",
            "headers": {
              "X-Request-Id": {
                "$ref": "#/components/headers/X-Request-Id"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenResponse"
                }
              }
            }
          },
          "400": {
            "description": "unsupported_grant_type, invalid_request, invalid_scope or unknown_parameter.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/OAuthProblem"
                }
              }
            }
          },
          "401": {
            "description": "invalid_client: unknown client, wrong secret or revoked key.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/OAuthProblem"
                }
              }
            }
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "413": {
            "$ref": "#/components/responses/BodyTooLarge"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          }
        }
      }
    },
    "/me": {
      "get": {
        "tags": [
          "Authentication"
        ],
        "operationId": "getMe",
        "summary": "Check your token",
        "description": "Returns the partner and key the token belongs to, its scopes and your contracted limits. Use it to confirm your integration is connected.",
        "responses": {
          "200": {
            "description": "Token details.",
            "headers": {
              "X-Request-Id": {
                "$ref": "#/components/headers/X-Request-Id"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Me"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/UnknownParameter"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          }
        }
      }
    },
    "/vehicles": {
      "get": {
        "tags": [
          "Stock"
        ],
        "operationId": "listVehicles",
        "summary": "List vehicles",
        "description": "Without updated_since: every vehicle in your scope that is available or reserved (a full sync). With updated_since: every vehicle that changed after that time, oldest change first, including sold ones and tombstones for vehicles that left your scope (a change sync). Page through with next_cursor until it is null.",
        "security": [
          {
            "bearer": []
          },
          {
            "oauth": [
              "stock:read"
            ]
          }
        ],
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Page size, 1 to 100 (default 50).",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 50
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "description": "next_cursor from the previous page, exactly as returned.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "updated_since",
            "in": "query",
            "required": false,
            "description": "ISO 8601 time. Returns only changes after it. At most 30 days back.",
            "schema": {
              "type": "string",
              "format": "date-time"
            },
            "example": "2026-10-10T04:00:00Z"
          },
          {
            "name": "make",
            "in": "query",
            "required": false,
            "description": "Make slug from GET /catalog/makes.",
            "schema": {
              "type": "string"
            },
            "example": "toyota"
          },
          {
            "name": "model",
            "in": "query",
            "required": false,
            "description": "Model slug from GET /catalog/models.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "body_type",
            "in": "query",
            "required": false,
            "description": "Body type slug from GET /catalog/body-types.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "year_min",
            "in": "query",
            "required": false,
            "description": "Earliest year.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "year_max",
            "in": "query",
            "required": false,
            "description": "Latest year.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "price_min",
            "in": "query",
            "required": false,
            "description": "Lowest price, in your prices.",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "price_max",
            "in": "query",
            "required": false,
            "description": "Highest price, in your prices.",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "description": "Only available or only reserved vehicles.",
            "schema": {
              "type": "string",
              "enum": [
                "available",
                "reserved"
              ]
            }
          },
          {
            "$ref": "#/components/parameters/IfNoneMatch"
          }
        ],
        "responses": {
          "200": {
            "description": "A page of vehicles.",
            "headers": {
              "X-Request-Id": {
                "$ref": "#/components/headers/X-Request-Id"
              },
              "ETag": {
                "$ref": "#/components/headers/ETag"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VehicleList"
                }
              }
            }
          },
          "304": {
            "description": "Not modified since the ETag you sent. Does not count against your daily limit."
          },
          "400": {
            "description": "unknown_parameter, invalid_cursor, sync_window_exceeded or price_filter_unavailable.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          },
          "422": {
            "$ref": "#/components/responses/ValidationFailed"
          }
        }
      }
    },
    "/vehicles/{stock_no}": {
      "get": {
        "tags": [
          "Stock"
        ],
        "operationId": "getVehicle",
        "summary": "Get one vehicle",
        "description": "One vehicle by stock number. Sold vehicles stay readable for 30 days. A vehicle outside your scope answers 404, the same as one that does not exist.",
        "security": [
          {
            "bearer": []
          },
          {
            "oauth": [
              "stock:read"
            ]
          }
        ],
        "parameters": [
          {
            "name": "stock_no",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "E02060"
          },
          {
            "$ref": "#/components/parameters/IfNoneMatch"
          }
        ],
        "responses": {
          "200": {
            "description": "The vehicle.",
            "headers": {
              "X-Request-Id": {
                "$ref": "#/components/headers/X-Request-Id"
              },
              "ETag": {
                "$ref": "#/components/headers/ETag"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data"
                  ],
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/Vehicle"
                    }
                  }
                }
              }
            }
          },
          "304": {
            "description": "Not modified."
          },
          "400": {
            "$ref": "#/components/responses/UnknownParameter"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
